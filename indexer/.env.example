# Envio HyperIndex — sentinel-indexer configuration template.
#
# Token for HyperSync / Envio Cloud (https://envio.dev/app/api-tokens).
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"

# --- Indexed contract + ranges (see config.yaml) -------------------------
# SentinelAuditAnchor address on Monad testnet (STUB-17: set after deploy).
# ENVIO_-prefixed vars work on the hosted service; ANCHOR_CONTRACT_ADDRESS
# (the repo-wide name in .env) is accepted as a fallback.
# ENVIO_ANCHOR_CONTRACT_ADDRESS=0x...
# Chain start block (0 => HyperSync auto-detect first event).
# ENVIO_START_BLOCK=0
# Per-contract start block override.
# ENVIO_ANCHOR_START_BLOCK=0
# RPC used as fallback/realtime source on Monad testnet.
# ENVIO_RPC_URL=https://testnet-rpc.monad.xyz

# --- Local anvil runs (config.local-anvil.yaml) ---------------------------
# The host may already serve :8080 (Hasura's default), so move the local
# GraphQL port; the local e2e in docs/evidence/p12-envio-anvil.txt uses 8888.
HASURA_EXTERNAL_PORT=8888
# ENVIO_LOCAL_RPC_URL=http://127.0.0.1:8547
