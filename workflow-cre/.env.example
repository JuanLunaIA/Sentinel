# Secrets for LOCAL SIMULATION / the fallback runner — copy to `.env`.
# Values are picked up by `cre workflow simulate` via ../secrets.yaml, and by
# the local runner / emulator directly from the environment.
# DO NOT COMMIT the copied `.env` (repo .gitignore already excludes it).

# Must equal the breaker's BREAKER_ARM_SECRET. Demo value used by
# scripts/breaker-demo.sh and tools/stale-breaker-emulator.ts: demo-secret
BREAKER_ARM_SECRET=demo-secret

# Optional — only when telegram.enabled=true in the workflow config.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
